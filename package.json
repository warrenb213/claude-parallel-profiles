{
  "name": "cppo",
  "displayName": "CPPO — Claude Parallel Profile Orchestration",
  "description": "Make Claude Code the lead of a multi-model team: delegate answers and sandboxed agent tasks to GLM, GPT (Codex) and Claude across the services you use, routed by roles with fallbacks and reviewed before they land — plus a Claude account per VS Code window, with one shared history.",
  "version": "1.18.2",
  "publisher": "BeboutItSolutions",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/warrenb213/cppo"
  },
  "sponsor": {
    "url": "https://paypal.me/beboutit503"
  },
  "bugs": {
    "url": "https://github.com/warrenb213/cppo/issues"
  },
  "license": "MIT",
  "author": {
    "name": "dercasdrol"
  },
  "cppo": {
    "generation": 4
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "profiles",
    "profile manager",
    "accounts",
    "multi-account"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Claude accounts live in data directories on the local file system, which virtual workspaces don't have."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Works in Restricted Mode. The extension never reads or executes workspace content — it only uses the workspace folder path to tell windows apart."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cppo.switchAccount",
        "title": "Switch Account for This Window",
        "category": "CPPO"
      },
      {
        "command": "cppo.captureAccount",
        "title": "Save Current Account",
        "category": "CPPO"
      },
      {
        "command": "cppo.showStatus",
        "title": "Account Quick Action",
        "category": "CPPO"
      },
      {
        "command": "cppo.removeProfile",
        "title": "Forget a Saved Account",
        "category": "CPPO"
      },
      {
        "command": "cppo.showLog",
        "title": "Show Log",
        "category": "CPPO"
      },
      {
        "command": "cppo.switchProvider",
        "title": "Switch Provider for This Window",
        "category": "CPPO"
      },
      {
        "command": "cppo.addProvider",
        "title": "Add a Provider",
        "category": "CPPO"
      },
      {
        "command": "cppo.editProvider",
        "title": "Edit or Remove a Provider",
        "category": "CPPO"
      },
      {
        "category": "CPPO",
        "command": "cppo.showAgentTasks",
        "title": "Show Agent Tasks"
      },
      {
        "category": "CPPO",
        "command": "cppo.showUsage",
        "title": "Show Provider Usage"
      },
      {
        "category": "CPPO",
        "command": "cppo.showWorkerTranscripts",
        "title": "Show Worker Transcripts"
      },
      {
        "category": "CPPO",
        "command": "cppo.showOrchestration",
        "title": "Orchestration (Roles and Fallbacks)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "vscode:uninstall": "node ./uninstall.js",
    "package": "vsce package",
    "release": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
